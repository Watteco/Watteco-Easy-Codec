+// Keep vendor ATT codes: CoreBluetooth can describe all of them as "Unknown ATT error".
+func bleErrorToString(_ error: Error) -> String {
+    let nativeError = error as NSError
+    guard nativeError.domain == CBATTErrorDomain else {
+        return nativeError.localizedDescription
+    }
+    return "\(nativeError.localizedDescription) (ATT 0x\(String(nativeError.code, radix: 16)))"
+}
