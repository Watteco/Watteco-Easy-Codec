# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

deploy.config.ps1

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/drafts
/node_modules
/platforms
/plugins
/www

# Environment files and local overrides
.env
.env.*
!.env.example
!.env.*.example
*.local

# Test artifacts
/cypress/screenshots/
/cypress/videos/
/test-results/
/playwright-report/

/ignored/